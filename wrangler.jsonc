{
  "name": "thinklabdigitalsolutions",
  "main": "src/index.js",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "thinklab", "database_id": "REPLACE_WITH_D1_ID", "migrations_dir": "migrations" }
  ],
  "kv_namespaces": [
    { "binding": "STORE", "id": "REPLACE_WITH_KV_ID" }
  ]
}
